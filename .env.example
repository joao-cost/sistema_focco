# Copie este arquivo para .env (desenvolvimento) e configure os valores reais
# em produção via docker-compose.prod.yml / secrets da sua VPS, ou via
# Environment Variables do projeto na Vercel.

# String de conexão do Postgres usada pela APLICAÇÃO em tempo de execução.
# Dev local via docker-compose: postgresql://focco:focco@db:5432/sistema_focco
#
# Na Vercel + Supabase: use a connection string do POOLER (Supavisor), modo
# "Transaction", porta 6543 — encontrada em Project Settings > Database >
# Connection string > "Transaction pooler" no painel do Supabase. Algo como:
#   postgresql://postgres.xxxxxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# (necessário porque funções serverless abrem/fecham muitas conexões; o
# Postgres do Supabase Free só aceita ~60 conexões diretas simultâneas).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sistema_focco"

# String de conexão DIRETA (sem pooler) — usada apenas para rodar migrations
# (DDL), tanto localmente (drizzle-kit) quanto em produção (scripts/migrate.mjs).
# Em Docker/VPS sem pooler, pode deixar igual a DATABASE_URL (ou omitir; o
# código cai para DATABASE_URL automaticamente).
#
# Na Vercel + Supabase: use a connection string "Direct connection", porta
# 5432 (mesma tela do painel, mas sem "pooler" no host). Algo como:
#   postgresql://postgres:SENHA@db.xxxxxxxxxxxx.supabase.co:5432/postgres
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/sistema_focco"

# Tamanho do pool de conexões por instância do app.
# - Docker/VPS (processo único e persistente): pode ser maior (padrão 10).
# - Vercel (serverless): mantenha baixo (1-2) — cada invocação de função é
#   curta e o Supavisor do Supabase já cuida do pooling real.
# DATABASE_POOL_MAX=10

# Chave usada pelo Auth.js para assinar sessões/JWT.
# Gere uma nova para produção com: openssl rand -base64 32
AUTH_SECRET="dev-secret-change-me-in-production"

# Necessário para self-hosting fora da Vercel (VPS, Docker, Nginx/Traefik na frente).
# Sem isso o Auth.js rejeita requisições com "UntrustedHost".
# Na Vercel isso NÃO é necessário (a Vercel já é um host confiável por padrão).
AUTH_TRUST_HOST=true

# URL pública onde a aplicação roda (ajuda o Auth.js a montar callbacks corretos
# atrás de um proxy reverso). Ex: https://focco.seudominio.com.br
# Na Vercel normalmente não precisa definir — o Auth.js detecta a URL sozinho.
# AUTH_URL="https://focco.seudominio.com.br"
