# Copie este arquivo para .env (desenvolvimento). Em produção, as mesmas
# variáveis são definidas direto no Portainer (stack "focco").

# String de conexão do Postgres.
# Dev local via docker-compose: postgresql://focco:focco@db:5432/sistema_focco
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sistema_focco"

# Tamanho do pool de conexões por instância do app (processo único e
# persistente no Docker/VPS — pode ficar alto sem problema).
# DATABASE_POOL_MAX=10

# Chave usada pelo Auth.js para assinar sessões/JWT.
# Gere uma nova para produção com: openssl rand -base64 32
AUTH_SECRET="dev-secret-change-me-in-production"

# Necessário rodando atrás de proxy reverso (VPS, Docker, Nginx/Traefik).
# Sem isso o Auth.js rejeita requisições com "UntrustedHost".
AUTH_TRUST_HOST=true

# URL pública onde a aplicação roda (ajuda o Auth.js a montar callbacks
# corretos atrás de um proxy reverso). Ex: https://appfocco.seudominio.com
# AUTH_URL="https://appfocco.seudominio.com"

# E-mail transacional via SMTP do Gmail (Senha de App) — opcional em dev.
# Sem isso, os e-mails de "esqueci minha senha", convite de usuário e aviso
# só são logados no console (ver src/lib/email.ts), nada é enviado de
# verdade. Ver README > "E-mail (SMTP Gmail)" pra gerar a Senha de App.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="seuprojeto@gmail.com"
# SMTP_PASS="senha-de-app-de-16-caracteres"
# EMAIL_FROM="FOCCO <seuprojeto@gmail.com>"

# Armazenamento de arquivos (hoje: foto de perfil) via Cloudflare R2 —
# opcional em dev. Sem isso, cai pro fallback em disco local (ver
# src/lib/storage.ts). Ver README > "Armazenamento de arquivos (R2)".
# R2_ACCOUNT_ID="id-da-conta-cloudflare"
# R2_ACCESS_KEY_ID="access-key-id-do-token-r2"
# R2_SECRET_ACCESS_KEY="secret-access-key-do-token-r2"
# R2_BUCKET="sistema-focco"
# R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"
