# Copie para .env.prod na sua VPS e preencha com valores reais.
# NÃO faça commit deste arquivo preenchido.

DB_PASSWORD=troque-por-uma-senha-forte
AUTH_SECRET=troque-pelo-resultado-de-openssl-rand-base64-32

# --- Usado por docker-compose.prod.yml (sem HTTPS automático) ---
AUTH_URL=https://focco.seudominio.com.br

# --- Usado por docker-stack.yml (Docker Swarm, usando o Traefik já existente
#     na VPS — rede HDSwarmNet, certresolver "letsencryptresolver") ---
# Domínio do sistema (com um registro A apontando para o IP da VPS).
DOMAIN=appfocco.hyperdynamis.com
# Imagem publicada no Docker Hub pelo GitHub Actions (usuário/repositório:tag).
DOCKERHUB_IMAGE=seuusuario/sistema_focco:latest

# --- E-mail transacional via SMTP do Gmail (Senha de App) — opcional. Sem
#     isso, os e-mails de "esqueci minha senha", convite de usuário e aviso
#     só são logados no console, não enviados de verdade.
#     Ver README > "E-mail (SMTP Gmail)". ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuprojeto@gmail.com
SMTP_PASS=senha-de-app-de-16-caracteres
EMAIL_FROM="FOCCO <seuprojeto@gmail.com>"
